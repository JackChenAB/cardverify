# ====== Database (used by both the db service and the backend) ======
POSTGRES_USER=cardverify
POSTGRES_PASSWORD=change_this_db_password
POSTGRES_DB=cardverify

# ====== Public HTTP port for the admin UI + API (host side) ======
HTTP_PORT=8080

# ====== Initial admin account (seeded on first boot only) ======
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password

# ====== Secrets — generate with: cd backend && node scripts/genkeys.js ======
# HMAC shared secret for client request signing (embed in the native client)
APP_SECRET=
# Admin session JWT secret
JWT_SECRET=
# Ed25519 response-signing key pair (base64-encoded PEM)
ED25519_PRIVATE_KEY=
ED25519_PUBLIC_KEY=

# ====== JWT lifetime ======
JWT_EXPIRES_IN=12h
